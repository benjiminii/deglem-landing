---
import { useTranslations, type Lang } from '../i18n/utils';
import StoreBadges from './StoreBadges.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="download" class="bg-charcoal py-20">
  <div class="mx-auto max-w-3xl px-5 text-center">
    <h2 class="text-3xl font-bold text-cream">{t('cta.heading')}</h2>
    <p class="mt-3 text-muted">{t('cta.subtitle')}</p>
    <StoreBadges class="mt-8 justify-center" />
  </div>
</section>
