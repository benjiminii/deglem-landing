---
interface Props { icon: string; title: string; desc: string }
const { icon, title, desc } = Astro.props;
---

<div class="rounded-xl border border-cream-border bg-cream p-6 text-left">
  <div class="text-3xl" aria-hidden="true">{icon}</div>
  <h3 class="mt-4 text-lg font-semibold text-charcoal">{title}</h3>
  <p class="mt-2 text-sm text-muted">{desc}</p>
</div>
