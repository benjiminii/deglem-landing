---
import { useTranslations, type Lang } from '../i18n/utils';
import PhoneMockup from './PhoneMockup.astro';
import StoreBadges from './StoreBadges.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="mx-auto max-w-5xl px-5 py-16 text-center sm:py-24">
  <h1 class="mx-auto max-w-2xl text-4xl font-bold leading-tight text-charcoal sm:text-5xl">
    {t('hero.title')}
  </h1>
  <p class="mx-auto mt-4 max-w-xl text-lg text-muted">{t('hero.subtitle')}</p>

  <div class="mt-10 flex justify-center">
    <PhoneMockup screenshot="/screenshots/dashboard.png" alt="Deglem dashboard" class="w-56 sm:w-64" />
  </div>

  <StoreBadges class="mt-10 justify-center" />
</section>
