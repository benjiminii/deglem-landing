---
import { useTranslations, type Lang } from '../i18n/utils';
import LanguageToggle from './LanguageToggle.astro';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const t = useTranslations(lang);
---

<header class="sticky top-0 z-10 border-b border-cream-border bg-cream/90 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4">
    <a href={lang === 'en' ? '/' : '/mn/'} class="text-xl font-bold text-charcoal">Deglem</a>
    <div class="flex items-center gap-4">
      <LanguageToggle lang={lang} path={path} />
      <a
        href="#download"
        class="rounded-lg bg-charcoal px-4 py-2 text-sm font-medium text-cream transition-opacity hover:opacity-80"
      >
        {t('nav.download')}
      </a>
    </div>
  </nav>
</header>
