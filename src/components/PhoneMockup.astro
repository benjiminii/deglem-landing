---
interface Props {
  screenshot: string; // path under /public, e.g. '/screenshots/dashboard.png'
  alt: string;
  class?: string;
  rotate?: number; // degrees, optional for gallery
}
const { screenshot, alt, class: className = '', rotate = 0 } = Astro.props;
const style = rotate ? `transform: rotate(${rotate}deg)` : undefined;
---

<div
  class={`rounded-[2.6rem] bg-charcoal p-2 shadow-2xl ring-1 ring-black/20 ${className}`}
  style={style}
>
  <!-- aspect matches the native screenshot ratio (1206x2622) so nothing is cropped -->
  <div class="relative aspect-[1206/2622] overflow-hidden rounded-[2.1rem] bg-cream">
    <img src={screenshot} alt={alt} width="603" height="1311" class="block h-full w-full" loading="lazy" />
    <!-- Dynamic Island -->
    <div class="absolute left-1/2 top-[1.7%] h-[2.9%] w-[33%] -translate-x-1/2 rounded-full bg-charcoal" aria-hidden="true"></div>
  </div>
</div>
