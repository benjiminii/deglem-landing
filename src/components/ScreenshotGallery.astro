---
import { useTranslations, type Lang } from '../i18n/utils';
import PhoneMockup from './PhoneMockup.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="mx-auto max-w-5xl px-5 py-16">
  <h2 data-reveal class="text-center text-3xl font-bold text-charcoal sm:text-4xl">{t('gallery.heading')}</h2>
  <div data-reveal style="--reveal-delay:120ms" class="mt-12 flex items-end justify-center gap-4 sm:gap-6">
    <PhoneMockup screenshot="/screenshots/profile.png" alt={t('gallery.profile')} class="hidden w-40 sm:block" rotate={-6} />
    <PhoneMockup screenshot="/screenshots/dashboard.png" alt={t('gallery.dashboard')} class="w-48 sm:w-52" />
    <PhoneMockup screenshot="/screenshots/progress.png" alt={t('gallery.progress')} class="hidden w-40 sm:block" rotate={6} />
  </div>
</section>
