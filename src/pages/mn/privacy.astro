---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'mn';
const path = '/privacy';
const t = useTranslations(lang);
---

<Base lang={lang} path={path} title={`${t('privacy.title')} — Deglem`}>
  <Nav lang={lang} path={path} />
  <main class="mx-auto max-w-3xl px-5 py-16">
    <h1 class="text-3xl font-bold text-charcoal">{t('privacy.title')}</h1>
    <div class="mt-6 space-y-4 leading-relaxed text-muted">
      <p>{t('privacy.body')}</p>
    </div>
  </main>
  <Footer lang={lang} path={path} />
</Base>
